<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host tools Mono's class library build runs, built for .NET on the PC.

       cil-stringreplacer is compiled from Mono's own source. Mono's corlib Makefile runs it on
       mscorlib.dll to rename the internal System.Diagnostics.Debug out of the way, fill in
       exception messages from mscorlib.txt, and swap in the Unsafe method bodies ilasm assembles.

       ilasm comes from Microsoft's package. It is only downloaded; ILAsmPath points at it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>cil-stringreplacer</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0618;CS0672;CS8981;SYSLIB0003;SYSLIB0051</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RollForward>Major</RollForward>
    <ILAsmVersion>8.0.0</ILAsmVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../vendor/mono/mcs/tools/cil-stringreplacer/cil-stringreplacer.cs" />
    <Compile Include="../../vendor/mono/mcs/class/Mono.Options/Mono.Options/Options.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageDownload Include="runtime.win-x64.Microsoft.NETCore.ILAsm" Version="[$(ILAsmVersion)]" />
  </ItemGroup>

  <Target Name="PrintILAsmPath">
    <Message Importance="high" Text="$(NuGetPackageRoot)runtime.win-x64.microsoft.netcore.ilasm/$(ILAsmVersion)/runtimes/win-x64/native/ilasm.exe" />
  </Target>

</Project>
